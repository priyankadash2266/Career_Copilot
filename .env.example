# Copy this file to .env.local and fill in your key.
# Without a key the app still works using rule-based insights.

# --- LLM (any OpenAI-compatible API) ----------------------------------------
# Google Gemini (free tier): create a key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# Other providers, just swap these values:
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=gpt-4o-mini
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=llama-3.3-70b-versatile
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1           LLM_MODEL=llama3.1   (any non-empty key)

# --- Limits (optional) ------------------------------------------------------
LLM_TIMEOUT_MS=25000
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MINUTE=10

# --- Jobs board storage (optional) -------------------------------------------
# JSON file used by the jobs board. Created and seeded with demo posts on first run.
JOBS_DATA_FILE=.data/jobs.json

# --- Production (Vercel) -------------------------------------------------------
# Postgres connection string (Neon). When set, the jobs board uses Postgres
# instead of the local JSON file. Added automatically by the Vercel + Neon integration.
DATABASE_URL=
# Protects the daily import endpoint. Any long random string; Vercel Cron sends it.
CRON_SECRET=
